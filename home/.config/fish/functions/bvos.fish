# sesh integration - generated by: bvo init --sesh
function bvos --description 'Pick a bvo project and connect with sesh'
    set -l row (command bvo list --format tsv --limit 0 --include-cwd | fzf --delimiter='\t' --with-nth=3,4 --no-sort --prompt='project> ' --preview 'sesh preview {1}' $argv)
    or return

    test -z "$row"; and return

    set -l path (printf '%s' "$row" | cut -f2)
    set -l project (printf '%s' "$row" | cut -f3)

    command bvo touch "$project" >/dev/null 2>&1
    sesh connect "$path"
end
