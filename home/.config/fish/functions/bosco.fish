# Side Project Manager - generated by: bosco init fish
function bosco --wraps bosco
    set -l argc (builtin count $argv)

    if test $argc -eq 0
        set -l dir (command bosco pick)
        and cd $dir
        return
    end

    set -l cmd $argv[1]
    switch $cmd
        case get-root init ls add add-multiple remove list pick -V --version -h --help
            command bosco $argv
        case '*'
            set -l dir (command bosco pick $argv)
            and cd $dir
    end
end
