# Side Project Manager - generated by: bvo init fish
function bvo --wraps bvo
    set -l argc (builtin count $argv)

    if test $argc -eq 0
        set -l dir (command bvo pick)
        and cd $dir
        return
    end

    set -l cmd $argv[1]
    switch $cmd
        case add list pick remove init tag config check-update get touch -V --version -h --help
            command bvo $argv
        case '*'
            set -l dir (command bvo pick $argv)
            and cd $dir
    end
end
