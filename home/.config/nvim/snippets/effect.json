{
  "effect-fn-generator": {
    "prefix": "efg",
    "body": [
      "const ${1:name} = Effect.fn(\"${1:name}\")(function*() {",
      "\t${2://content}",
      "})"
    ]
  },
  "effect-generator": {
    "prefix": "eg",
    "body": ["Effect.gen(function*() {", "\t$1", "})"]
  },
  "effect-log": {
    "prefix": "el",
    "body": "Effect.log${1}($2)",
    "description": "log fn for effect"
  },
  "yield-star": {
    "prefix": "yi",
    "body": "yield*"
  }
}
