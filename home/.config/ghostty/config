# Auto Update
auto-update = download
auto-update-channel = tip

# Theme
theme = 0x96f
background-blur = 50
background-opacity = 0.85

# Clipboard
clipboard-read = "allow"
clipboard-write = "allow"
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = true

# Cursor
cursor-style = bar
cursor-style-blink = false

# Fonts
font-size = 16
font-family = "Paper Mono"
# font-family = "Berkeley Mono"
font-thicken = true
font-thicken-strength = 75

# macOS Settings
macos-titlebar-style = transparent
# macos-icon = retro
# macos-icon-frame = plastic
macos-non-native-fullscreen = true
macos-option-as-alt=true
# icon
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #00ccff
macos-icon-screen-color = #ffffff,#ffffff

# Mouse
mouse-hide-while-typing = true

# Quick Terminal
quick-terminal-animation-duration = 0.08
quick-terminal-position = center
quick-terminal-screen=main
quick-terminal-size = 60%,80%
#,900px

# Shell Integration
shell-integration = fish
shell-integration-features = no-cursor

# Window Settings
window-decoration = true 
window-padding-x = 12
window-padding-y = 12
window-inherit-working-directory = true
window-save-state = always
window-colorspace = "display-p3"
window-padding-balance = true

copy-on-select = clipboard

# Keybinds
keybind=clear

keybind = cmd+v=paste_from_clipboard
keybind = cmd+c=copy_to_clipboard

# # Window management
keybind = cmd+shift+r=reload_config
keybind = cmd+q=quit
keybind = cmd+shift+n=new_window

# # Split management
keybind = cmd+enter=new_split:right
keybind = cmd+shift+enter=new_split:down

# command palette
keybind = cmd+shift+p=toggle_command_palette

# Font size
keybind = cmd+shift+equal=increase_font_size:2
keybind = cmd+shift+minus=decrease_font_size:2
keybind = cmd+0=reset_font_size

# Miscellaneous
keybind = alt+enter=toggle_fullscreen
keybind = cmd+shift+\=toggle_window_float_on_top

# New tmux tab/window
keybind = cmd+t=text:\x01c

# Zoom current pane
keybind = cmd+slash=text:\x01z

# Close current tmux window
keybind = cmd+w=text:\x01w

# Native Ghostty splits
keybind = cmd+enter=text:\x01|
keybind = cmd+shift+enter=text:\x01-

# tmux window selection
keybind = cmd+1=text:\x011
keybind = cmd+2=text:\x012
keybind = cmd+3=text:\x013
keybind = cmd+4=text:\x014
keybind = cmd+5=text:\x015
keybind = cmd+6=text:\x016
keybind = cmd+7=text:\x017
keybind = cmd+8=text:\x018
keybind = cmd+9=text:\x019
