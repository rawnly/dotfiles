[user]
	name = Federico
	email = 16429579+rawnly@users.noreply.github.com
	signingkey = /Users/federico.vitale/.ssh/id_github.pub
[core]
  pager = delta
  editor = nvim --cmd 'let g:unception_block_while_host_edits=1'
  excludesfile = ~/.gitignore_global
[init]
  defaultBranch = main
[interactive]
  diffFilter = delta --color-only
[diff]
  tool = deeelta
  renames = copy
[merge]
  conflictstyle = zdiff3
  tool = "nvim"
[mergetool]
  keepBackup = false
  prompt = false
[rebase]
	updateRefs = true
[pull]
  rebase = true
[push]
  autoSetupRemote = true
  default = current
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[gpg]
	format = ssh
[commit]
	gpgsign = true
[rerere]
	enabled = true

[alias]
  graph = !git log --oneline --graph
  ll = log --all --decorate --oneline --graph
  cleanup = !git branch --format="%(refname:short) %(upstream:track)" | rg gone | awk '{print $1}' | xargs -I{} git branch -D {}
  pushtest = !git push --force origin $(git rev-parse --abbrev-ref HEAD):test 
  pushstaging = !git push --force origin $(git rev-parse --abbrev-ref HEAD):staging
  diffgrep = "!f() { git diff -U1 | grepdiff $1 --output-matching=hunk; }; f"
  applygrep = "!f() { git diff -U1 | grepdiff $1 --output-matching=hunk | git apply --cached --unidiff-zero; }; f"
	fp = fetch --prune --all
	wt = !worktree-manager
	wtls = !worktree-manager list
	wtrm = !worktree-manager remove

[includeIf "gitdir:/Users/federico.vitale/Developer/satispay/"]
	path = /Users/federico.vitale/Developer/satispay/.gitconfig-satispay
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[url "git@github.com:"]
	insteadOf = https://github.com/
